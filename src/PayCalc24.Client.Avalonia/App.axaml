<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:actipro="http://schemas.actiprosoftware.com/avaloniaui"
             x:Class="PayCalc24.Client.Avalonia.App">
  <Application.Styles>
    <actipro:ModernTheme>
      <StyleInclude Source="avares://ActiproSoftware.Avalonia.Bars/Themes/Common.axaml" />
    </actipro:ModernTheme>
    <Style Selector="Border.tableRow">
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
  </Application.Styles>
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="BackgroundBrush" Color="#F4F6F8" />
          <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="TextPrimaryBrush" Color="#17212B" />
          <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5C6975" />
          <SolidColorBrush x:Key="BorderBrush" Color="#D8DEE4" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="BackgroundBrush" Color="#111827" />
          <SolidColorBrush x:Key="SurfaceBrush" Color="#1F2937" />
          <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F3F4F6" />
          <SolidColorBrush x:Key="TextSecondaryBrush" Color="#CBD5E1" />
          <SolidColorBrush x:Key="BorderBrush" Color="#475569" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
      <SolidColorBrush x:Key="SuccessBrush" Color="#16803A" />
      <SolidColorBrush x:Key="WarningBrush" Color="#B45F06" />
      <SolidColorBrush x:Key="ErrorBrush" Color="#C62828" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
