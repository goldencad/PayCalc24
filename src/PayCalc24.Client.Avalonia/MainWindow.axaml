<actipro:RibbonWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:actipro="http://schemas.actiprosoftware.com/avaloniaui"
        x:Class="PayCalc24.Client.Avalonia.MainWindow"
        Width="1280" Height="820" MinWidth="980" MinHeight="680"
        Title="{Binding AppTitle}" Background="{DynamicResource BackgroundBrush}">
  <actipro:RibbonContainerPanel>
    <ContentControl x:Name="RibbonHost">
    <actipro:Ribbon x:Name="MainRibbon">
      <actipro:Ribbon.ApplicationButtonContent>
        <actipro:RibbonApplicationButton Label="PayCalc24" KeyTipText="F" />
      </actipro:Ribbon.ApplicationButtonContent>
      <actipro:Ribbon.BackstageContent>
        <actipro:RibbonBackstage x:Name="MainBackstage" HeaderBackground="{DynamicResource SurfaceBrush}">
          <actipro:RibbonBackstageTabItem Key="Settings" Label="{Binding Workspace.BackstageSettings}">
            <Border Padding="32" Background="{DynamicResource SurfaceBrush}"><StackPanel Spacing="16"><TextBlock Text="{Binding Workspace.SettingsBackstage}" FontSize="22" /><TextBlock Text="{Binding Workspace.LanguageBackstage}" /><TextBlock Text="{Binding Workspace.AppearanceBackstage}" /></StackPanel></Border>
          </actipro:RibbonBackstageTabItem>
          <actipro:RibbonBackstageTabItem Key="About" Label="{Binding Workspace.BackstageAbout}">
            <Border Padding="32" Background="{DynamicResource SurfaceBrush}"><StackPanel Spacing="16"><TextBlock Text="{Binding Workspace.AboutBackstage}" FontSize="22" /><TextBlock Text="{Binding Workspace.CompanyBackstage}" /></StackPanel></Border>
          </actipro:RibbonBackstageTabItem>
          <actipro:RibbonBackstageHeaderSeparator HeaderAlignment="Bottom" />
          <actipro:RibbonBackstageHeaderButton Key="Exit" Label="{Binding Workspace.BackstageExit}" HeaderAlignment="Bottom" Command="{Binding ExitCommand}" />
        </actipro:RibbonBackstage>
      </actipro:Ribbon.BackstageContent>
      <actipro:RibbonTabItem Key="Home" Label="{Binding Workspace.RibbonHome}">
        <actipro:RibbonGroup Key="Navigate" Label="{Binding Workspace.RibbonNavigate}">
          <actipro:BarButton Key="Dashboard" Label="{Binding Workspace.RibbonDashboard}" Command="{Binding Workspace.SelectAreaCommand}" CommandParameter="DASHBOARD" />
          <actipro:BarButton Key="Subjects" Label="{Binding Workspace.RibbonSubjects}" Command="{Binding Workspace.SelectAreaCommand}" CommandParameter="SUBJECTS" />
        </actipro:RibbonGroup>
      </actipro:RibbonTabItem>
      <actipro:RibbonTabItem Key="Input" Label="{Binding Workspace.RibbonInput}">
        <actipro:RibbonGroup Key="Input" Label="{Binding Workspace.RibbonNavigate}">
          <actipro:BarButton Key="Inputs" Label="{Binding Workspace.RibbonInputs}" Command="{Binding Workspace.SelectAreaCommand}" CommandParameter="INPUTS" />
          <actipro:BarButton Key="Attendance" Label="{Binding Workspace.RibbonAttendance}" Command="{Binding Workspace.SelectAreaCommand}" CommandParameter="ATTENDANCE" />
          <actipro:BarButton Key="KPI" Label="{Binding Workspace.RibbonKpi}" Command="{Binding Workspace.SelectAreaCommand}" CommandParameter="KPI" />
        </actipro:RibbonGroup>
      </actipro:RibbonTabItem>
      <actipro:RibbonTabItem Key="Payroll" Label="{Binding Workspace.RibbonPayroll}">
        <actipro:RibbonGroup Key="Payroll" Label="{Binding Workspace.RibbonNavigate}">
          <actipro:BarButton Key="Prepare" Label="{Binding Workspace.RibbonPrepare}" Command="{Binding Workspace.SelectAreaCommand}" CommandParameter="PREPARE" />
          <actipro:BarButton Key="Calculate" Label="{Binding Workspace.RibbonCalculate}" Command="{Binding Workspace.SelectAreaCommand}" CommandParameter="CALCULATE" />
          <actipro:BarButton Key="Funds" Label="{Binding Workspace.RibbonFunds}" Command="{Binding Workspace.SelectAreaCommand}" CommandParameter="FUNDS" />
        </actipro:RibbonGroup>
      </actipro:RibbonTabItem>
      <actipro:RibbonTabItem Key="Review" Label="{Binding Workspace.RibbonReview}">
        <actipro:RibbonGroup Key="Review" Label="{Binding Workspace.RibbonNavigate}">
          <actipro:BarButton Key="Validate" Label="{Binding Workspace.RibbonValidate}" Command="{Binding Workspace.SelectAreaCommand}" CommandParameter="VALIDATE" />
          <actipro:BarButton Key="Explain" Label="{Binding Workspace.RibbonExplain}" Command="{Binding Workspace.SelectAreaCommand}" CommandParameter="EXPLAIN" />
          <actipro:BarButton Key="Variance" Label="{Binding Workspace.RibbonVariance}" Command="{Binding Workspace.SelectAreaCommand}" CommandParameter="VARIANCE" />
          <actipro:BarButton Key="Scenario" Label="{Binding Workspace.RibbonScenario}" Command="{Binding Workspace.SelectAreaCommand}" CommandParameter="SCENARIO" />
        </actipro:RibbonGroup>
      </actipro:RibbonTabItem>
      <actipro:RibbonTabItem Key="Approval" Label="{Binding Workspace.RibbonApproval}">
        <actipro:RibbonGroup Key="Approval" Label="{Binding Workspace.RibbonNavigate}">
          <actipro:BarButton Key="Approval" Label="{Binding Workspace.RibbonApprovalAction}" Command="{Binding Workspace.SelectAreaCommand}" CommandParameter="APPROVAL" />
          <actipro:BarButton Key="Settlement" Label="{Binding Workspace.RibbonSettlement}" Command="{Binding Workspace.SelectAreaCommand}" CommandParameter="SETTLEMENT" />
        </actipro:RibbonGroup>
      </actipro:RibbonTabItem>
      <actipro:RibbonTabItem Key="Finance" Label="{Binding Workspace.RibbonFinance}">
        <actipro:RibbonGroup Key="Finance" Label="{Binding Workspace.RibbonNavigate}"><actipro:BarButton Key="Accounting" Label="{Binding Workspace.RibbonAccounting}" Command="{Binding Workspace.SelectAreaCommand}" CommandParameter="ACCOUNTING" /></actipro:RibbonGroup>
      </actipro:RibbonTabItem>
      <actipro:RibbonTabItem Key="Reports" Label="{Binding Workspace.RibbonReports}">
        <actipro:RibbonGroup Key="Reports" Label="{Binding Workspace.RibbonNavigate}"><actipro:BarButton Key="Reports" Label="{Binding Workspace.RibbonReportAction}" Command="{Binding Workspace.SelectAreaCommand}" CommandParameter="REPORTS" /></actipro:RibbonGroup>
      </actipro:RibbonTabItem>
    </actipro:Ribbon>
    </ContentControl>
    <Grid RowDefinitions="Auto,*,Auto">
    <Border Padding="18,10" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="18">
          <TextBlock Text="{Binding AppTitle}" FontSize="21" FontWeight="Bold" VerticalAlignment="Center" />
          <StackPanel>
            <TextBlock Text="{Binding Workspace.Header}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Workspace.CompanyLabel, StringFormat='Company {0}'}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
          </StackPanel>
        </StackPanel>
        <TextBlock Grid.Column="2" Text="{Binding Workspace.DemoNotice}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
      </Grid>
    </Border>
    <Grid Grid.Row="1">
      <ScrollViewer>
        <StackPanel Margin="24" Spacing="18">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel><TextBlock Text="{Binding Workspace.AreaTitle}" FontSize="28" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Workspace.RevisionIdentity}" Foreground="{DynamicResource TextSecondaryBrush}" /></StackPanel>
            <Border Grid.Column="1" Padding="12,6" CornerRadius="12" Background="{DynamicResource AccentBrush}"><TextBlock Text="{Binding Workspace.DemoLabel}" Foreground="White" FontWeight="Bold" /></Border>
          </Grid>
          <ItemsControl ItemsSource="{Binding Workspace.Cards}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate><Border Width="165" Margin="0,0,10,10" Padding="14" CornerRadius="8" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"><StackPanel><TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding Value}" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding Workspace.WorkflowLabel}" FontSize="18" FontWeight="SemiBold" />
          <ItemsControl ItemsSource="{Binding Workspace.Steps}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Padding="12,8" Margin="0,0,8,8" CornerRadius="6" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"><StackPanel><TextBlock Text="{Binding Label}" FontWeight="SemiBold"/><TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          <TextBlock Text="{Binding Workspace.SubjectsLabel}" FontSize="18" FontWeight="SemiBold" />
          <ListBox ItemsSource="{Binding Workspace.Subjects}" MinHeight="120" />
          <TextBlock Text="{Binding Workspace.ComponentsLabel}" FontSize="18" FontWeight="SemiBold" />
          <ListBox ItemsSource="{Binding Workspace.Components}" MinHeight="140" />
          <TextBlock Text="{Binding Workspace.FundsLabel}" FontSize="18" FontWeight="SemiBold" />
          <ListBox ItemsSource="{Binding Workspace.Funds}" MinHeight="100" />
          <TextBlock Text="{Binding Workspace.ValidationLabel}" FontSize="18" FontWeight="SemiBold" />
          <ListBox ItemsSource="{Binding Workspace.Findings}" MinHeight="110" />
          <TextBlock Text="{Binding Workspace.StatutoryLabel}" FontSize="18" FontWeight="SemiBold" />
          <ListBox ItemsSource="{Binding Workspace.Statutory}" MinHeight="120" />
          <TextBlock Text="{Binding Workspace.MissingStatutoryNotice}" Foreground="{DynamicResource WarningBrush}" />
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <Border Grid.Row="2" Padding="14,8" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
      <TextBlock Text="{Binding Workspace.ActivityText}" Foreground="{DynamicResource TextSecondaryBrush}" />
    </Border>
    </Grid>
  </actipro:RibbonContainerPanel>
</actipro:RibbonWindow>
